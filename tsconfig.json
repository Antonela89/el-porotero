{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "composite": true,
        "paths": {
            "@el-porotero/shared": [
                "./packages/shared/index.ts"
            ]
        }
    },
    "files": [], // El archivo raíz no tiene código propio
    "references": [
        {
            "path": "./apps/api"
        },
        {
            "path": "./packages/shared"
        }
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}