{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "typeRoots": [
            "./node_modules/@types",
            "src/custom_types"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@shared/*": [
                "../../packages/shared/"
            ]
        },
    },
    "include": [
        "src/**/*",
        "src/custom_types/express.d.ts"
    ]
}