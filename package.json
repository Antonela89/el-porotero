    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @el-porotero/shared build && pnpm --filter web build",
    "build:api": "pnpm --filter @el-porotero/shared build && pnpm --filter api build",
    "start": "node apps/api/dist/server.js",
    "clean": "pnpm -r exec rm -rf node_modules dist .vite"
